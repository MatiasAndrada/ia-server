{
  "name": "ia-server",
  "version": "1.0.0",
  "description": "API REST de IA para sistema de gestión de listas de espera vía WhatsApp usando OpenRouter",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r ./.ts-node-loader.js -r ./.dev-env.js src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ia-server",
    "pm2:restart": "npm run build && pm2 restart ia-server",
    "pm2:logs": "pm2 logs ia-server",
    "pm2:delete": "pm2 delete ia-server",
    "pm2:dev:start": "pm2 start ecosystem.dev.config.js",
    "pm2:dev:stop": "pm2 stop ia-server-dev",
    "pm2:dev:restart": "pm2 restart ia-server-dev",
    "pm2:dev:logs": "pm2 logs ia-server-dev",
    "pm2:dev:delete": "pm2 delete ia-server-dev",
    "supabase:gen": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/types/supabase.ts",
    "types:generate": "ts-node scripts/generate-types.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:manual": "ts-node src/__tests__/manual/test-real-business.ts",
    "test:reservation": "jest reservation-flow",
    "chat:simulate": "ts-node scripts/chat-simulator.ts",
    "test:integration": "jest --testPathPattern=integration",
    "whatsapp:connect": "node whatsapp-client.js",
    "whatsapp:clean": "rm -rf auth_sessions/*",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "eval": "ts-node scripts/agent-eval.ts"
  },
  "keywords": [
    "ia",
    "openrouter",
    "llm",
    "whatsapp",
    "waitlist",
    "restaurant",
    "ai",
    "chatbot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "axios": "^1.19.0",
    "baileys": "^7.0.0-rc14",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "qrcode-terminal": "^0.12.0",
    "redis": "^6.2.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}

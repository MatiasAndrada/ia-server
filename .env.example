# Server Configuration
PORT=4000

# Modo de ejecución: production, development, test
# - production: responde a todos los chats de clientes, ignora mensajes propios (fromMe)
# - test: responde SOLO en tu chat personal de WhatsApp, ignora otros chats
NODE_ENV=production

# OpenRouter Configuration (https://openrouter.ai)
# ⚠️ COMPLETAR con tu API key real antes de reiniciar el servicio — el server
# no arranca sin este valor (falla rápido en vez de correr con IA rota).
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
# Formato "vendor/modelo". Elegir en https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Opciones alternativas de modelos (comentadas como referencia):
#OPENROUTER_MODEL=anthropic/claude-opus-4.8
#OPENROUTER_MODEL=google/gemini-2.5-flash-lite
#OPENROUTER_MODEL=google/gemini-3.7-flash
#OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Opcional: modelos alternativos separados por coma para failover automático de OpenRouter
# si el modelo principal está caído o rate-limited (se prueban en orden)
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT=30000
# Opcionales, usados por OpenRouter solo para atribución en su leaderboard público
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Security
API_KEY=tu_api_key_secreta_aqui_cambiar_en_produccion
# Orígenes reales que pueden llamar esta API desde un browser (CORS).
# Esto NO protege las llamadas server-to-server de nubotik (Vercel) — esas no
# pasan por CORS porque no las hace un browser. Es defensa en profundidad por si
# algún día algo del lado cliente llama a esta API directo.
# Agregá acá tu dominio custom si nubotik también responde en uno propio.
ALLOWED_ORIGINS=https://tu-dominio.com,http://localhost:3000

# Redis Cache
REDIS_URL=redis://localhost:6379
# --- Locks distribuidos (Redis SET NX/EX) ---
# Evitan condiciones de carrera cuando dos requests corren casi al mismo tiempo
# (dos mensajes de WhatsApp seguidos, dos instancias del server, un reintento, etc.).
# Se implementan como un SET key value NX EX <ttl> en Redis: si la key ya existe,
# el segundo proceso no consigue el lock y aborta/espera en vez de duplicar trabajo.
# El TTL es una red de seguridad: si el proceso que tomó el lock se cuelga o crashea
# sin liberarlo, Redis lo borra solo pasados estos segundos y el sistema no queda
# bloqueado para siempre. Valor mínimo aceptado por el código: 5s (si se configura
# menos, o algo no numérico, cae al default de 20s).
# Si Redis no está conectado, ambos locks se saltean (no bloquean el flujo).

# TTL del lock "reservation_create_lock:<businessId>:<customerPhone>".
# Se toma en ReservationService.createReservation() antes de insertar la reserva
# y se libera apenas termina. Sirve para que, si el mismo cliente manda dos
# mensajes de confirmación muy seguidos (doble tap, reintento del cliente de WhatsApp,
# etc.), no se creen dos reservas duplicadas para el mismo teléfono+negocio.
# Subir este valor solo si la creación de una reserva (validaciones + insert en
# Supabase) puede tardar más de 20s; bajarlo reduce cuánto tiempo queda "trabado"
# el mismo teléfono si el proceso muere sin liberar el lock.
RESERVATION_CREATE_LOCK_TTL_SECONDS=20

# TTL del lock "session:start:lock:<businessId>". Se toma en
# BaileysService.startSession() antes de crear el socket de WhatsApp (Baileys)
# para ese negocio, y se libera al terminar (éxito o error). Evita que dos
# arranques concurrentes de la MISMA sesión (ej. un webhook de reconexión y un
# restart manual disparados juntos) creen dos sockets/auth en paralelo, lo que
# puede corromper el estado de auth_sessions o generar conflictos de sesión (440)
# con WhatsApp. Igual que arriba, el TTL es el techo de tiempo que el lock queda
# tomado si el proceso se cuelga antes de liberarlo.
BAILEYS_START_SESSION_LOCK_TTL_SECONDS=20

# Optional: Redis with auth
# REDIS_URL=redis://:password@localhost:6379

# --- Mensajes automáticos alrededor de la reserva ---
# Los tres scanners viven en el proceso y dependen de Redis para no repetir
# envíos: si Redis está caído, no mandan nada.

# M10a — Recordatorio con antelación, con la opción de cancelar. Minutos antes
# de scheduled_at. Sólo aplica a reservas con día y hora (no a las instantáneas)
# y en estado WAITING o CONFIRMED. Poner 0 para deshabilitarlo.
RESERVATION_REMINDER_LEAD_MINUTES=60

# M10b — Aviso de proximidad ("ya deberías estar cerca"). Minutos antes de
# scheduled_at. Funciona además como piso del recordatorio anterior: si el
# proceso estuvo caído y una reserva aparece con menos margen que este valor, el
# de antelación ya no sale (mandar "falta una hora" cuando faltan diez es peor
# que no mandar nada). Poner 0 para deshabilitarlo.
RESERVATION_ARRIVAL_REMINDER_LEAD_MINUTES=15

# M12 — Mensaje posterior a la visita. Minutos después de que la reserva pasa a
# SEATED. Sólo sale si en ese momento sigue en SEATED.
POST_VISIT_DELAY_MINUTES=120

# Logging — ver docs/LOGGING.md
# info  = sólo eventos relevantes (~1 línea por turno de conversación)
# debug = suma toda la traza paso a paso, para reproducir un caso puntual
LOG_LEVEL=info

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# For automatic type generation with CLI (optional):
# SUPABASE_PROJECT_ID=your-project-id
# SUPABASE_ACCESS_TOKEN removido: es un token de cuenta (Management API, no de
# proyecto) y el runtime nunca lo usa — solo lo lee `npm run supabase:gen` a
# mano en tu máquina local. No debe vivir en el .env de un server en producción
# ni en Vercel. Pasalo como variable de entorno puntual al correr ese script:
#   SUPABASE_ACCESS_TOKEN=sbp_... npm run supabase:gen

# Testing (opcional - solo si necesitas valores para testing)
# TEST_PHONE=tu_telefono_test_aqui
# TEST_BUSINESS_ID=tu_business_id_test_aqui

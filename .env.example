# Server Configuration
PORT=4000

# Modo de ejecución: production, development, test
# - production: responde a todos los chats de clientes, ignora mensajes propios (fromMe)
# - test: responde SOLO en tu chat personal de WhatsApp, ignora otros chats
NODE_ENV=production

# OpenRouter Configuration (https://openrouter.ai)
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
# Formato "vendor/modelo", ej: anthropic/claude-3.5-sonnet, openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# Opcional: modelos alternativos separados por coma para failover automático de OpenRouter
# si el modelo principal está caído o rate-limited (se prueban en orden)
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT=30000
# Opcionales, usados por OpenRouter solo para atribución en su leaderboard público
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Security
API_KEY=tu_api_key_secreta_aqui_cambiar_en_produccion
ALLOWED_ORIGINS=https://tu-dominio.com,http://localhost:3000

# Redis Cache
REDIS_URL=redis://localhost:6379
# TTL (segundos) del lock distribuido para serializar creación de reservas por teléfono
RESERVATION_CREATE_LOCK_TTL_SECONDS=20
# TTL (segundos) del lock distribuido para evitar arranques concurrentes de sesión WhatsApp
BAILEYS_START_SESSION_LOCK_TTL_SECONDS=20

# Optional: Redis with auth
# REDIS_URL=redis://:password@localhost:6379

# Logging
LOG_LEVEL=info

# Supabase Configuration (Optional - for reservations and database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
# For automatic type generation with CLI (optional):
# SUPABASE_PROJECT_ID=your-project-id
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
